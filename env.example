# Copy to .env (same folder as docker-compose.yml) and fill in. .env is git-ignored.
#   cp env.example .env            (macOS / Linux)
#   Copy-Item env.example .env     (Windows PowerShell)

# Your notes folder (Obsidian vault or any folder of .md files).
# Windows: forward slashes, e.g. C:/Users/you/Documents/MyVault
# macOS/Linux: /home/you/notes
VAULT_PATH=

# Where the hook writes events.jsonl. Empty = ~/.vault-radar
# Windows example: C:/Users/you/.vault-radar
RADAR_DATA=

# Host port for the viewer (published on 127.0.0.1 only).
RADAR_PORT=7777

# Characters per token for the size estimate: ≈3.6 Turkish, ≈4.0 English.
VAULT_RADAR_CPT=3.8

# Linux only: your user and group id (`id -u`, `id -g`).
RADAR_UID=1000
RADAR_GID=1000
